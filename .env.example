# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Application Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database (Production uses Managed PostgreSQL, local uses built-in transactional store)
DATABASE_URL="postgresql://mevo_user:password@localhost:5432/mevotech_db?schema=public"

# Store Information (South Africa)
STORE_NAME="Mevo Tech"
STORE_CURRENCY="ZAR"
STORE_TIMEZONE="Africa/Johannesburg"
STORE_VAT_RATE=15

# Authentication
AUTH_SECRET="your-secure-random-32-byte-secret"
AUTH_URL="http://localhost:3000"

# Payment Gateways (South African ZAR Integrations)
# PayFast Sandbox & Production
PAYFAST_MERCHANT_ID="10000100"
PAYFAST_MERCHANT_KEY="46f0cd694581a"
PAYFAST_PASSPHRASE="testpassphrase"
PAYFAST_SANDBOX="true"

# Payflex BNPL (Buy-Now-Pay-Later)
PAYFLEX_CLIENT_ID="sandbox_client_id"
PAYFLEX_CLIENT_SECRET="sandbox_secret"
PAYFLEX_ENVIRONMENT="sandbox"

# Ozow Instant EFT
OZOW_SITE_CODE="MEV-001"
OZOW_PRIVATE_KEY="sandbox_private_key"
OZOW_API_KEY="sandbox_api_key"
OZOW_ENVIRONMENT="sandbox"

# Paystack (ZAR Card & EFT)
PAYSTACK_PUBLIC_KEY="pk_test_sample"
PAYSTACK_SECRET_KEY="sk_test_sample"
PAYSTACK_CURRENCY="ZAR"

# Cryptocurrency Gateway
CRYPTO_PROVIDER="coinbase_commerce"
CRYPTO_API_KEY="test_crypto_api_key"
CRYPTO_WEBHOOK_SECRET="test_crypto_webhook_secret"

# Email Provider
EMAIL_PROVIDER="smtp"
EMAIL_API_KEY="test_api_key"
EMAIL_FROM="orders@mevotech.co.za"

# Admin Initial Setup
ADMIN_INITIAL_SETUP_TOKEN="admin-setup-dev-token"
