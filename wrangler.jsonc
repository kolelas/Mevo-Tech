{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mevo-tech-staging",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "containers": [
    {
      "class_name": "MevoApiContainer",
      "image": "./Dockerfile",
      "max_instances": 2,
      "instance_type": "lite"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "API_CONTAINER",
        "class_name": "MevoApiContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MevoApiContainer"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  }
}
